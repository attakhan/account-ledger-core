{
  "name": "account-ledger-core",
  "version": "1.0.0",
  "description": "In-memory, append-only, sharded account ledger core with a six-day event replay",
  "private": true,
  "type": "commonjs",
  "engines": { "node": ">=20" },
  "bin": { "ledger-replay": "bin/replay.js" },
  "scripts": {
    "replay": "node bin/replay.js data/scenario.ndjson",
    "replay:sharded": "node bin/replay.js data/scenario.ndjson --shards 2",
    "test": "node --test test/unit/*.test.js test/scenario/*.test.js",
    "test:known-failing": "node --test test/known-failing/*.test.js",
    "test:all": "node --test test/unit/*.test.js test/scenario/*.test.js test/known-failing/*.test.js",
    "gen:load": "node scripts/gen-load.js",
    "bench": "node scripts/bench.js"
  },
  "license": "UNLICENSED"
}
